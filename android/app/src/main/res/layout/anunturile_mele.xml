<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:layout_marginEnd="0dp"
    android:background="@drawable/anunt_style"
    android:orientation="horizontal"
    android:padding="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imageView"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:padding="0dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/RoundedLeftCorners"
        tools:src="@tools:sample/avatars" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitlu"
            android:layout_width="162dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Titlu Anunt"
            android:textAlignment="center"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTimpRamas"
                android:layout_width="190dp"
                android:layout_height="match_parent"
                android:text="Timp ramas hh:mm:dd"
                android:textAlignment="center"
                android:textColor="#767171" />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="27dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                app:srcCompat="@android:drawable/arrow_down_float" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPretActual"
            android:layout_width="166dp"
            android:layout_height="wrap_content"
            android:text="Pret: 0 RON"
            android:textAlignment="center"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="166dp"
            android:layout_height="wrap_content"
            android:text="Status:"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>