<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121214"
    tools:context=".Pagina_anunt">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Imagine Header -->
            <ImageView
                android:id="@+id/headerImage"
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Cardul Principal de Conținut -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-40dp"
                app:cardBackgroundColor="#1C1C1F"
                app:cardCornerRadius="32dp"
                app:cardElevation="8dp"
                app:layout_constraintTop_toBottomOf="@id/headerImage"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Titlul Anunțului -->
                    <TextView
                        android:id="@+id/id_titlu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Titlu"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- Cardul de Licitație -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardBackgroundColor="#252529"
                        app:cardCornerRadius="20dp"
                        app:strokeColor="#333338"
                        app:strokeWidth="1dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <!-- Secțiunea Last Bid -->
                            <TextView
                                android:id="@+id/id_lastbid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Last Bid: 100 RON"
                                android:textColor="#4CAF50"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <!-- Secțiunea Soldul Tău -->

                            <TextView
                                android:id="@+id/id_sold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Soldul:\n100000RON"
                                android:textAlignment="viewEnd"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toTopOf="@+id/divider"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <View
                                android:id="@+id/divider"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="12dp"
                                android:background="#333338"
                                app:layout_constraintTop_toBottomOf="@id/id_lastbid" />

                            <!-- Detalii Timp -->
                            <TextView
                                android:id="@+id/id_timp_ramas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Timp ramas: hh:mm:ss"
                                android:textColor="#FFFFFF"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/divider" />

                            <!-- Ultima Licitatie -->
                            <TextView
                                android:id="@+id/id_ultima_licitatie"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Ultima licitatie:"
                                android:textColor="#BDBDBD"
                                android:textSize="13sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/id_timp_ramas" />

                            <!-- Lider -->
                            <TextView
                                android:id="@+id/Lider"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="32dp"
                                android:text="Lider-ul:"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toTopOf="@+id/linearLayout"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@id/id_ultima_licitatie" />

                            <!-- Input Sumă și Buton Bid -->
                            <LinearLayout
                                android:id="@+id/linearLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal"
                                app:layout_constraintTop_toBottomOf="@id/id_ultima_licitatie"
                                tools:layout_editor_absoluteX="16dp">

                                <EditText
                                    android:id="@+id/id_suma"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/rounded_edittext"
                                    android:hint="Introduceti suma"
                                    android:paddingStart="16dp"
                                    android:textColor="#FFFFFF"
                                    android:textColorHighlight="#FFFFFF"
                                    android:textColorHint="#FFFFFF"
                                    android:textSize="14sp" />

                                <Button
                                    android:id="@+id/id_bid_button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="50dp"
                                    android:layout_marginStart="12dp"
                                    android:background="@drawable/round_buttons"
                                    android:text="BID"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"
                                    app:backgroundTint="@null"
                                    app:strokeColor="#FFB300" />
                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Secțiunea Descriere -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Descriere"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="#252529"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="#333338"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/id_descriere_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="4dp"
                            android:padding="16dp"
                            android:text="Descriere text aici..."
                            android:textColor="#CCCCCC"
                            android:textColorHint="#FFFFFF" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Spațiere finală -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="40dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Elemente de Animație (Fixe deasupra cardului) -->

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/konfettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/txtWinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EȘTI CÂȘTIGĂTOR!"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtLiderAnim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LIDER!"
        android:textColor="#4CAF50"
        android:textSize="60sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- Buton Înapoi -->
    <ImageButton
        android:id="@+id/id_return_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF"
        android:contentDescription="Înapoi"/>

</androidx.constraintlayout.widget.ConstraintLayout>